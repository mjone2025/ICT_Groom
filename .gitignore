# Ignore everything in root by default
/*

# Whitelist: Allow only .gitignore and the 3 specified folders
!.gitignore
!/Myhome/
!/goorm_ai/
!/goorm_course/

# Common build, dependency, and log exclusions inside whitelisted folders
node_modules/
**/node_modules/
dist/
build/
**/dist/
**/build/
.wrangler/
.vinext/
.openai/
*.log
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
desktop.ini
