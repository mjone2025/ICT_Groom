                        <a class="font-label-sm text-label-sm text-on-surface-variant hover:text-primary transition-colors"
                            href="#">주요 활동</a>
                        <a class="font-label-sm text-label-sm text-on-surface-variant hover:text-primary transition-colors"
                            href="#">프로젝트</a>
                        <a class="font-label-sm text-label-sm text-on-surface-variant hover:text-primary transition-colors"
                            href="#">문의</a>
                    </div>
                </footer>
            </div>
        </section>
        <!-- Floating AI Prompt Widget -->
        <div
            class="fixed bottom-lg right-lg w-72 glass-panel p-md rounded-2xl shadow-2xl z-50 border-primary/20 pointer-events-auto">
            <div class="flex items-center justify-between mb-sm">
                <span class="font-mono-xs text-mono-xs text-primary font-bold">AI 어시스턴트</span>
                <span class="material-symbols-outlined text-on-surface-variant text-sm cursor-pointer"
                    onclick="this.parentElement.parentElement.remove()">close</span>
            </div>
            <p class="text-xs text-on-surface-variant mb-md italic">"경력 경로 섹션을 개선하고 싶으신가요? AI 운영 체제와 관련된 임팩트 있는 키워드를 추천해
                드릴 수 있습니다."</p>
            <button
                class="w-full text-xs py-2 bg-primary/20 text-primary rounded-lg border border-primary/30 hover:bg-primary/30 transition-colors font-bold uppercase tracking-wider">제안
                수락하기</button>
        </div>
    </main>
    <script>
        // Global Timer Logic
        let countdownInterval;
        let remainingTime = 0; // in seconds

        function updateTimerDisplay() {
            const minutes = Math.floor(remainingTime / 60);
            const seconds = remainingTime % 60;
            const display = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
            document.getElementById('timer-countdown').textContent = display;
        }

        function handleTimerClick(mins) {
            // 1. Reset any existing timer
            handleStopClick();

            // 2. Start 3D animation (ANIMATION_14 logic)
            if (window.startThreeTimer) {
                window.startThreeTimer(mins);
            }

            // 3. Start JS Countdown
            remainingTime = mins * 60;
            updateTimerDisplay();

            countdownInterval = setInterval(() => {
                remainingTime--;
                if (remainingTime < 0) {
                    handleStopClick();
                    alert("집중 시간이 종료되었습니다!");
                    return;
                }
                updateTimerDisplay();
            }, 1000);
        }

        function handleStopClick() {
            clearInterval(countdownInterval);
            remainingTime = 0;
            updateTimerDisplay();
            if (window.stopThreeTimer) {
                window.stopThreeTimer();
            }
        }

        // UI Interactions
        document.querySelectorAll('button, a').forEach(el => {
            el.addEventListener('mousedown', () => el.style.transform = 'scale(0.98)');
            el.addEventListener('mouseup', () => el.style.transform = '');
            el.addEventListener('mouseleave', () => el.style.transform = '');
        });

        const canvasSection = document.querySelector('section');
        canvasSection.addEventListener('scroll', () => {
            const scrollY = canvasSection.scrollTop;
            const opacity = Math.min(scrollY / 300, 0.9);
            document.querySelector('header').style.backgroundColor = `rgba(11, 19, 38, ${opacity})`;
        });

        // Three.js 3D Timer Animation Integration (ANIMATION_14)
        (function () {
            const container = document.getElementById('threejs-container-ANIMATION_12');
            if (!container) return;

            const devicePixelRatio = window.devicePixelRatio || 1;
            const width = container.clientWidth || window.innerWidth;
            const height = container.clientHeight || window.innerHeight;

            const scene = new THREE.Scene();
            const camera = new THREE.PerspectiveCamera(75, width / height, 0.1, 1000);
            camera.position.z = 5;

            const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
            renderer.setSize(width, height);
            renderer.setPixelRatio(devicePixelRatio);
            container.appendChild(renderer.domElement);

            // Lighting
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.5);
            scene.add(ambientLight);

            const pointLight = new THREE.PointLight(0x6366f1, 2, 10);
            pointLight.position.set(2, 2, 2);
            scene.add(pointLight);

            // Glowing Ring for Timer
            const geometry = new THREE.TorusGeometry(2, 0.05, 16, 100);
            const material = new THREE.MeshPhongMaterial({
                color: 0x6366f1,
                emissive: 0x6366f1,
                emissiveIntensity: 0.5,
                transparent: true,
                opacity: 0.8
            });
            const ring = new THREE.Mesh(geometry, material);
            scene.add(ring);

            // Particles
            const particlesGeometry = new THREE.BufferGeometry();
            const particlesCount = 400;
            const posArray = new Float32Array(particlesCount * 3);
            for (let i = 0; i < particlesCount * 3; i++) {
                posArray[i] = (Math.random() - 0.5) * 15;
            }
            particlesGeometry.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
            const particlesMaterial = new THREE.PointsMaterial({
                size: 0.02,
                color: 0x818cf8,
                transparent: true,
                opacity: 0.6
            });
            const particlesMesh = new THREE.Points(particlesGeometry, particlesMaterial);
            scene.add(particlesMesh);

            let isRunning = false;
            let startTime = 0;
            let duration = 0;

            // Global functions to control the 3D scene from the HTML side
            window.startThreeTimer = function (mins) {
                console.log("Starting 3D Timer for", mins, "mins");
                isRunning = true;
                startTime = Date.now();
                duration = mins * 60 * 1000;
            };

            window.stopThreeTimer = function () {
                isRunning = false;
            };

            function animate() {
                requestAnimationFrame(animate);

                ring.rotation.z += 0.005;
                particlesMesh.rotation.y += 0.001;

                let scale = 1 + Math.sin(Date.now() * 0.001) * 0.05;

                if (isRunning) {
                    const elapsed = Date.now() - startTime;
                    const progress = Math.min(elapsed / duration, 1);

                    // Intensity pulse gets faster and stronger as time runs out
                    const pulseSpeed = 0.01 + (progress * 0.05);
                    scale = 1 + (Math.sin(Date.now() * pulseSpeed * 1000) * (0.1 + progress * 0.2));

                    ring.material.emissiveIntensity = 0.5 + progress * 4;
                    ring.material.color.setHSL(0.66 - (progress * 0.2), 0.8, 0.5); // Shift indigo to purple-ish

                    if (progress >= 1) {
                        isRunning = false;
                    }
                } else {
                    ring.material.emissiveIntensity = 0.5;
                    ring.material.color.setHex(0x6366f1);
                }

                ring.scale.set(scale, scale, scale);
                renderer.render(scene, camera);
            }

            window.addEventListener('resize', () => {
                const newWidth = container.clientWidth || window.innerWidth;
                const newHeight = container.clientHeight || window.innerHeight;
                camera.aspect = newWidth / newHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(newWidth, newHeight);
            });

            animate();
        })();
    </script>
</body>

</html>